{
  "name": "@oryxel/db",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:check": "drizzle-kit check --dialect postgresql --out drizzle",
    "db:check-history": "bun src/check-migrations.ts",
    "db:push": "bun --env-file=../../.env.development drizzle-kit push --force",
    "db:generate": "bun --env-file=../../.env.development drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env.development src/migrate.ts",
    "db:migrate:prod": "bun --env-file=../../.env.production src/migrate.ts",
    "db:studio": "bun --env-file=../../.env.development drizzle-kit studio",
    "db:verify-migration": "bun src/verify-migration.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
