# Drizzle
# Replace with your DB credentials!
DATABASE_URL=
# Separate canonical perfume catalog database.
CATALOG_DATABASE_URL=

# One-time escape hatch for a legacy database created with drizzle-kit push.
# Set only while adopting migration history, then remove it.
# DATABASE_MIGRATION_BASELINE=0006_social_layer

ORIGIN=

# Operational controls. Readiness checks cap dependency probes at 10 seconds.
MAINTENANCE_MODE="false"
HEALTHCHECK_TIMEOUT_MS="2000"

# Better Auth
# For production use 32+ characters generated with high entropy
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Protects the platform-access administration endpoint.
ADMIN_SECRET=

# AI Router
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
QWEN_API_KEY=
QWEN_MODEL=
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Optional application-funded provider shared by web and worker.
PLATFORM_AI_PROVIDER=
PLATFORM_AI_KEY=
AI_ROUTER_PROVIDER_ORDER=
AI_ROUTER_TIMEOUT_MS="90000"
AI_ROUTER_MAX_RETRIES="1"
AI_ROUTER_MAX_ATTEMPTS="4"

AI_KEYS_ENCRYPTION_KEY=

# Shared Redis for web rate limiting, worker notifications, and the job-stream gateway.
REDIS_URL=
# Job SSE stream. Web needs JWT secret + public gateway URL.
JOB_STREAM_JWT_SECRET=
# Required on Vercel for SSE (expose to Production + Preview; redeploy after change — client bundle reads it at build time).
PUBLIC_JOB_STREAM_URL=
# Gateway only: browser origin for CORS (e.g. https://your-app.vercel.app). Use * for local dev.
STREAM_CORS_ORIGIN=
# Gateway reconciliation and connection bounds.
STREAM_RECONCILE_INTERVAL_MS="5000"
MAX_ACTIVE_STREAMS="200"
MAX_ACTIVE_STREAMS_PER_USER="5"

# Optional local seed identity.
SEED_USER_ID=

# Operator-only cutover verifier inputs. Keep real URLs outside the repository.
SOURCE_DATABASE_URL=
DESTINATION_DATABASE_URL=
PROD_URL=
DESTINATION_EXTRA_TABLE_ALLOWLIST=
WORKER_WINDOW_HOURS="1"
